{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rustore-downloader",
  "main": "./worker/site-worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
