# CORS: set to the exact GitHub Pages origin in production.
ALLOWED_ORIGINS=https://Basil-AS.github.io

# Optional: use your own gplaydl dispenser. Default is https://dispenser.gplaydl.com
# GPLAYDL_DISPENSER_URL=https://dispenser.example.com

# Optional non-interactive pairing. Prefer `docker compose exec backend gplaydl link`.
# GPLAYDL_API_KEY=
# GPLAYDL_EMAIL=spare-google-account@example.com

MANIFEST_TTL=2700
MAX_MANIFESTS=64
# 64 is intentionally above the current bundled profile count, so Deep Scan
# traverses every profile available for a selected architecture by default.
MAX_SCAN_PROFILES=64

# Local key used ONLY for reconstructed merged APKs. Original Play files are untouched.
MERGE_STOREPASS=change-this-long-random-password
